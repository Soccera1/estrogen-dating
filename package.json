{
  "name": "estrogen-dating",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && node scripts/openapi.mjs && vite build && node scripts/build-worker.mjs",
    "dev:api": "node scripts/dev-worker.mjs",
    "test": "vitest run",
    "test:browser": "node tests/browser.mjs",
    "test:cpu": "node tests/avatar-cpu.mjs",
    "migrate": "node scripts/migrate.mjs",
    "check:free": "node scripts/check-free.mjs",
    "deploy": "node scripts/deploy.mjs",
    "check:deployment": "node scripts/check-deployment.mjs",
    "configure": "python3 scripts/configure.py"
  },
  "dependencies": {
    "hono": "^4.12.0",
    "jose": "^6.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/workers-types": "5.20260926.1",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.25.0",
    "miniflare": "5.20260925.0-alpha",
    "prettier": "^3.9.9",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.2"
  }
}
