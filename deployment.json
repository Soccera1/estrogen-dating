{
  "accountId": "YOUR_CLOUDFLARE_ACCOUNT_ID",
  "worker": {
    "name": "estrogen-dating",
    "compatibilityDate": "2026-09-25",
    "assets": {
      "notFoundHandling": "single-page-application",
      "runWorkerFirst": ["/api/*", "/auth/*"]
    },
    "domains": [],
    "workersDev": true,
    "previewUrls": false,
    "observability": {
      "enabled": false
    },
    "unsafe": {
      "metadata": {
        "usage_model": "standard"
      }
    },
    "env": {
      "DB": {
        "type": "d1",
        "name": "estrogen-dating-db",
        "id": "YOUR_D1_DATABASE_ID"
      },
      "ASSETS": {
        "type": "assets"
      },
      "APP_ORIGIN": {
        "type": "text",
        "value": "https://estrogen-dating.YOUR_SUBDOMAIN.workers.dev"
      },
      "HRTID_ISSUER": {
        "type": "text",
        "value": "https://id.estrogen.delivery"
      },
      "HRTID_CLIENT_ID": {
        "type": "text",
        "value": "YOUR_HRTID_CLIENT_ID"
      }
    }
  },
  "billingMode": "free"
}
